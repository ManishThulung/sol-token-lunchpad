
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleteAt  DateTime?

  tokens    SolanaToken[]
}

model SolanaToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner / creator
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Solana token information
  mintAddress    String? @unique
  mintAuthority  String
  decimals       Int

  // Token metadata
  name        String
  symbol      String
  description String
  imageUrl    String
  metadataUri String? @unique

  // Authority configuration
  revokeFreeze Boolean @default(false)

  // Optional status
  status SolanaTokenStatus @default(PENDING)
}

enum SolanaTokenStatus {
  PENDING
  CREATED
  FAILED
}